# suitescript-verify settings for this folder (see README.md). Committed: never put credentials here.
SUITESCRIPT_VERIFY_PROBES_DIR=probes
SUITESCRIPT_VERIFY_RESULTS_DIR=results
SUITESCRIPT_VERIFY_SDF_DIR=sdf
# Optional, set in .env.local (gitignored) rather than here:
# SUITESCRIPT_VERIFY_RUNNER_ID names the runner (default suitescript_verify). Set your own
#   if another project's runner is already deployed in the same sandbox.
# SUITESCRIPT_VERIFY_ROLE_ID is the role the runner runs as (default customrole_<runner id>).
